# VCS
.git
.github
.forgejo
.gitignore
.gitattributes

# IDE / editor
.idea
.vscode
.zed
.fleet
.nova
.claude
.phpactor.json
.phpunit.cache
.phpunit.result.cache

# Local env — never bake into an image
.env
.env.*
auth.json

# Built / installed locally — rebuilt inside the image
node_modules
vendor
public/build
public/hot
public/storage

# Storage runtime state — must not bake in
storage/logs/*
!storage/logs/.gitkeep
storage/framework/cache/data/*
!storage/framework/cache/data/.gitkeep
storage/framework/sessions/*
!storage/framework/sessions/.gitkeep
storage/framework/views/*
!storage/framework/views/.gitkeep
storage/pail
storage/*.key

# Local-dev SQLite database — must never bake into a prod image.
database/database.sqlite
database/*.sqlite

# Tests + docs
tests
phpunit.xml
# `docs/*` rather than `docs` so the third-party license inventory below
# can be re-included — Docker cannot un-ignore a file inside a directory
# that was itself excluded.
docs/*
*.md
!README.md

# Licensing must travel with the software. The AGPL requires the license
# text to reach every recipient of the program, and an operator poking
# around a running container should be able to find out what they're
# allowed to do with it without going back to the repository.
!LICENSING.md
!SECURITY.md
!TRADEMARK.md
!docs/third-party-licenses.md

# Other-image source / infra not needed at Laravel runtime
agent-worker
deploy
# Local-dev k3d + edge tooling, including the edge's self-signed TLS
# key (local/edge/tls) — image scanners flag it as a leaked credential.
local

# The Dockerfile + .dockerignore themselves
Dockerfile
.dockerignore

# Misc
.DS_Store
Thumbs.db
Homestead.json
Homestead.yaml
