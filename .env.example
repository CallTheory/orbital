# -------------------------------------------------------------
# Orbital environment configuration
# -------------------------------------------------------------
# Two kinds of settings live in this file:
#
#   1. Settings that ALSO have an admin-UI override in System →
#      Settings. The UI writes to the platform_settings table
#      and RuntimeConfigOverrideProvider applies those on top of
#      .env at boot. For those settings this file is the FALLBACK
#      shown when no DB override exists. Edit either place; the DB
#      wins when both are populated.
#
#   2. Settings that are DELIBERATELY .env-only — container-time
#      configuration (docker-compose service env), infrastructure
#      tied to DNS / PKI / container parity, or boot-critical vars
#      that would brick the UI if set to a bad value from the UI.
#
# For the longer-form rationale on which settings are on which
# side and why, see docs/ENVIRONMENT.md.
# -------------------------------------------------------------

APP_NAME=Orbital
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# -------------------------------------------------------------
# Release identity + AGPL section 13 source offer
# -------------------------------------------------------------
# Orbital is AGPL-3.0. If you run a MODIFIED Orbital and let anyone
# use it over a network — clients in the portal, operators, staff —
# section 13 asks you to offer them the source of what they are
# actually running.
#
# Orbital does that for you: the footer of every panel, the /source
# route, and /api/version all read ORBITAL_SOURCE_URL. Point it at
# YOUR repository when you fork. Leaving it aimed upstream while
# shipping changed code sends your users to source that isn't yours.
#
# VERSION and COMMIT are normally baked into the image at build time
# (Dockerfile ARGs) and don't need to be set here.
ORBITAL_SOURCE_URL=https://git.calltheory.com/calltheory/orbital
# ORBITAL_VERSION=dev
# ORBITAL_COMMIT=
# ORBITAL_RELEASE_CHANNEL=dev

# Support subscription (optional, gates NOTHING).
# Ed25519 public key used to verify a support subscription key offline.
# Official builds bake in Call Theory's key. Unset means "no vendor
# support relationship", which is a completely normal state — every
# feature works identically either way.
# ORBITAL_SUPPORT_PUBLIC_KEY=
# ORBITAL_SUPPORT_PORTAL_URL=https://calltheory.com/orbital/support

# -------------------------------------------------------------
# Two-factor enforcement
# -------------------------------------------------------------
# Applies to EVERYONE — platform staff and client portal users. Staff
# can see every client's messages and recordings, so the case for a
# second factor is stronger for them, not weaker.
#
# The grace clock starts on a user's FIRST REQUEST under the policy,
# not at account creation, so enabling this does not lock out every
# existing user the moment it ships. Per-client windows live on
# teams.two_factor_grace_days; the value here is the fallback for
# platform staff, who have no client team.
#
# Set TWO_FACTOR_REQUIRED=false to switch enforcement off without a
# code change — turning it on is the kind of change that can lock
# people out, so turning it back off must not need a deploy.
# TWO_FACTOR_REQUIRED=true
# TWO_FACTOR_GRACE_DAYS=7

# -------------------------------------------------------------
# Messaging channel (SMS / MMS / paging)
# -------------------------------------------------------------
# The inbound webhook is POST /api/messaging/inbound/{provider} and is
# PUBLIC by necessity — the carrier has to reach it. Its defence is
# per-provider signature verification, which fails CLOSED: an
# unconfigured provider rejects every request rather than accepting
# them. Set the credentials for whichever transports you use.
#
# The `log` provider exists so the whole pipeline (routing, threading,
# the operator inbox) can be exercised offline with no carrier account.
# It still requires a secret — a dev transport that fails open is what
# ends up filling a staging box with garbage.
# MESSAGING_LOG_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
#
# How long after a conversation closes a new text reopens it rather
# than starting fresh. 72h keeps "sorry, one more thing" the next
# morning in context without stapling next month's unrelated problem
# onto a resolved complaint.
# MESSAGING_THREAD_REOPEN_HOURS=72
#
# Let the AI answer inbound texts directly. OFF by default and
# deliberately so: an AI that starts texting a client's customers
# without the client asking for it is far worse than a slow human
# reply. Requires a persona on the queue as well.
# MESSAGING_AUTO_REPLY_ENABLED=false
#
# Sending goes through the carrier's SENDER POOL (Twilio Messaging
# Service and equivalents), configured per client on the messaging
# endpoint rather than here. There is no env switch to send from a bare
# number: that path bypasses carrier opt-out enforcement, and a number
# that ignores STOP is a number that gets de-registered.
#
# Inbound MMS attachments are pulled off the carrier into the object
# store, because a provider URL is not a copy — it expires, needs the
# carrier's credentials, and vanishes with the account.
# MESSAGING_MEDIA_DISK=s3
# MESSAGING_MEDIA_MAX_BYTES=16777216
# MESSAGING_MEDIA_TIMEOUT=30
#
# How long a signed attachment link stays valid. Short on purpose: an
# MMS to an answering service is somebody's insurance photo or their
# prescription label.
# MESSAGING_MEDIA_LINK_TTL=15
#
# Delete the carrier's copy once ours is written. Good for cost and for
# not leaving customers' photographs on a third party's storage
# indefinitely — but irreversible, so it is never the default.
# MESSAGING_MEDIA_DELETE_FROM_PROVIDER=false
#
# Hosts the Twilio driver will attach account credentials to when
# downloading media. Only widen this if Twilio changes their API host.
# TWILIO_MEDIA_HOSTS=api.twilio.com
#
# Capture STOP/START/HELP from inbound messages into the per-client
# do-not-text list. Turning this OFF does not make sending compliant —
# suppressions already recorded are still enforced on every send; it
# only stops new ones being captured here.
# MESSAGING_HONOUR_OPT_OUT=true

# -------------------------------------------------------------
# Metrics
# -------------------------------------------------------------
# GET /metrics serves per-instance HTTP metrics for Prometheus. The
# app's HTTP port is not host-bound in the shipped compose topology,
# so only nginx-tls and Prometheus can reach it — set METRICS_TOKEN
# only if that stops being true in your deployment.
#
# Deployment-wide numbers (per-client volume, queue depth, Asterisk
# channel state) are NOT served here: the `orbital:collect-metrics`
# scheduled command pushes them to Pushgateway once a minute, so N
# app replicas don't each report the same global total. See
# config/metrics.php for the full reasoning.
# METRICS_ENABLED=true
# METRICS_TOKEN=
# METRICS_INSTANCE=            # defaults to the container hostname
# METRICS_PUSHGATEWAY_URL=http://pushgateway:9091
# METRICS_PER_CLIENT_LABELS=true   # off on installs with 1000s of clients

# First super-admin, created by FirstSuperAdminSeeder during
# `php artisan db:seed`. BOTH must be set or the seeder does nothing and
# the install has no login at all.
#
# Only useful on a first seed. After that, create administrators with
# `php artisan orbital:make-admin`, which takes the password on the
# command line instead of leaving it in a file. The Kubernetes chart
# never sets these for the same reason — a password passed through Helm
# values is readable by anyone with cluster read.
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_NAME=

# -------------------------------------------------------------
# Backups
# -------------------------------------------------------------
# Nightly encrypted PostgreSQL backup to an off-box destination.
#
# HA survives a dead node. Replication survives a dead disk. Neither
# survives a dropped table, a bad migration, or a compromised account —
# those replicate to every copy instantly and faithfully. This is the
# only one of the three that recovers from a mistake.
#
# Scope: the DATABASE. Object storage content (call recordings, MMS
# media, mail attachments) is NOT copied — see docs/admin/backups.md.
#
# Generate the key with:  php artisan orbital:backup --generate-key
# STORE IT OUTSIDE ORBITAL. Losing it means losing every archive taken
# with it; there is no recovery path, deliberately.
# BACKUP_ENABLED=false
# BACKUP_ENCRYPTION_KEY=
# BACKUP_KEEP_DAYS=30
#
# Destination credentials are SEPARATE from the app's AWS_* on purpose.
# Backups kept under the key the app writes recordings with die to the
# same compromised credential or buggy delete that destroys the
# recordings — which is the one failure a backup exists to survive.
# Give this key write + list on its own bucket and nothing else.
# BACKUP_AWS_BUCKET=
# BACKUP_AWS_ACCESS_KEY_ID=
# BACKUP_AWS_SECRET_ACCESS_KEY=
# BACKUP_AWS_ENDPOINT=
# BACKUP_AWS_DEFAULT_REGION=us-east-1
#
# With no bucket set the disk falls back to a local directory, which is
# fine for `--path` on a dev box and is NOT a backup in production —
# a local copy dies with the machine it is meant to protect.
# BACKUP_LOCAL_PATH=

# -------------------------------------------------------------
# Alerting
# -------------------------------------------------------------
# Prometheus evaluates docker/prometheus/rules/*.yml and Alertmanager
# delivers what fires. Alertmanager runs either way — with nothing set
# below, alerts still group, deduplicate, and are visible at
# http://localhost:9093, they are just not sent anywhere. An install
# that hasn't chosen a destination shouldn't be mailing a placeholder.
#
# SMTP is the recommended default because it leaves the box. An alert
# route that runs through the application being monitored isn't an
# alert route: when Laravel or Valkey or Postgres is down, that is
# exactly when the notification has to still get out.
#
# ALERT_EMAIL_TO is the switch. Set it and email delivery is rendered
# into the config; leave it blank and the receiver has no email block
# at all (Alertmanager refuses to start on an empty `to:`).
# ALERT_EMAIL_TO=ops@example.com
# ALERT_SMTP_SMARTHOST=mailpit:1025   # dev default; a real relay in prod
# ALERT_SMTP_FROM=alerts@orbital.test
# ALERT_SMTP_USERNAME=                # blank omits AUTH entirely
# ALERT_SMTP_PASSWORD=
# ALERT_SMTP_REQUIRE_TLS=false        # true for a relay that offers STARTTLS
#
# Generic webhook, for anything without a native Alertmanager receiver.
# NOTE: Alertmanager's webhook body is a FIXED JSON schema and cannot be
# templated (unlike its email receiver), so a service expecting readable
# text — ntfy, for instance — receives raw JSON unless you put a small
# translating bridge in front of it. For phone push via ntfy, pointing
# ALERT_SMTP_SMARTHOST at ntfy's own SMTP listener gives a formatted
# message and reuses the receiver you already configured.
# ALERT_WEBHOOK_URL=
#
# Used in notification links back to the Alertmanager UI.
# ALERT_EXTERNAL_URL=http://localhost:9093

# -------------------------------------------------------------
# Error Reporting (optional)
# -------------------------------------------------------------
# Ships unhandled exceptions to a GlitchTip or Sentry project. Off
# unless you switch it on AND supply a DSN — the toggle alone does
# nothing, so a half-finished setup can't look like it's working.
# GlitchTip implements Sentry's ingest API, so hosted and self-hosted
# DSNs are interchangeable and only the host differs.
#
# Also settable from Settings -> Platform -> Error Reporting, which is
# the better place for it: the DSN is stored encrypted there rather
# than sitting in a file. Horizon workers read this at boot, so
# restart them after changing it either way.
#
# Read config/observability.php before enabling this. Orbital handles
# other people's callers, and an exception report is a copy of whatever
# the process was holding — caller names, numbers, message bodies.
# Personal data is stripped on the way out and request bodies are never
# attached, but pointing this at somebody else's SaaS still exports
# your clients' stack traces off-site.
# ERROR_REPORTING_ENABLED=false
# ERROR_REPORTING_DSN=
# ERROR_REPORTING_ENVIRONMENT=      # defaults to APP_ENV
# ERROR_REPORTING_SAMPLE_RATE=1.0

# -------------------------------------------------------------
# Tracing (optional)
# -------------------------------------------------------------
# Distributed tracing over OTLP to Grafana Tempo, an OpenTelemetry
# Collector, Jaeger, or Grafana Cloud. Off by default. HTTP transport
# only (port 4318, full /v1/traces path) — never gRPC, which would
# need ext-grpc in the image and a TCP-mode HAProxy frontend instead
# of the ordinary HTTP ones the rest of the obs tier uses.
#
# Instrumentation is manual, at five seams: HTTP kernel, database,
# queue jobs, outbound HTTP, console commands. See the reasoning in
# config/observability.php for why not the PECL extension.
#
# Sampling defaults to 5%. Don't set this to 1.0 on a busy install:
# most requests are Livewire polls, and a backend that ingests all of
# them costs a lot without answering anything more. Sampling is
# parent-based, so a traced request keeps its jobs and outbound calls.
#
# Spans carry identifiers only — team, thread, call, user id. Never
# caller names, phone numbers, message bodies, or SQL bound values.
# TRACING_ENABLED=false
# TRACING_ENDPOINT=http://tempo:4318/v1/traces
# TRACING_PROTOCOL=http/protobuf   # or http/json when debugging
# TRACING_SERVICE_NAME=orbital
# TRACING_SAMPLE_RATIO=0.05
# TRACING_AUTH_MODE=none           # none | basic | bearer
# TRACING_AUTH_USERNAME=           # Grafana Cloud: the instance ID
# TRACING_AUTH_SECRET=
# TRACING_CAPTURE_DB=true
# TRACING_CAPTURE_QUEUE=true
# TRACING_CAPTURE_HTTP_CLIENT=true
# TRACING_MAX_DB_SPANS=100         # per trace; guards against N+1 floods

# Platform Operator (the company running this installation of Orbital)
PLATFORM_NAME=Orbital
PLATFORM_COMPANY=Orbital
PLATFORM_SUPPORT_EMAIL=
PLATFORM_SUPPORT_MESSAGE="Contact your platform administrator"

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=orbital
DB_USERNAME=orbital
DB_PASSWORD=password

# Session / Cache / Queue
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
# Default disk is the S3 driver pointing at SeaweedFS so uploads,
# recordings, knowledge files, and inbound email blobs all land on
# a storage backend that can be distributed across nodes.
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=valkey
# Valkey (Redis-compatible) password. Valkey is pinned via
# `--requirepass` on the container and every client — Laravel
# cache/session/queue, Horizon, Reverb, LiveKit, LiveKit SIP,
# Redis Commander — authenticates with this same value. Generate
# a fresh one per install with `openssl rand -hex 24` and copy
# the output into:
#   1. this .env (REDIS_PASSWORD)
#   2. docker/livekit/livekit.yaml (redis.password)
#   3. docker/livekit/sip-config.yaml (redis.password)
# and restart the stack. No null / empty passwords — this is
# the data plane for sessions, queues, and real-time events.
REDIS_PASSWORD=
REDIS_PORT=6379

# Mail (Mailpit for dev)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@orbital.local"
MAIL_FROM_NAME="${APP_NAME}"

# Inbound mail (Haraka SMTP → Laravel webhook).
# INBOUND_MAIL_TOKEN is the shared secret between Haraka and the
# /api/mail/inbound webhook — rotate by changing in both places.
# INBOUND_MAIL_DOMAIN is the user-facing domain in the RFC822
# envelope, e.g. {account_number}@inbound.orbital.test.
INBOUND_MAIL_TOKEN=
INBOUND_MAIL_DOMAIN=inbound.orbital.test
FORWARD_INBOUND_SMTP_PORT=2525

# Voicemail webhook (Asterisk externnotify → Laravel). Shared
# secret used by notify-voicemail.sh inside the asterisk container;
# generate with `openssl rand -hex 24` and rotate in both places.
VOICEMAIL_WEBHOOK_URL=http://orbital.test/api/voicemail/received
VOICEMAIL_WEBHOOK_TOKEN=

# Voicemail transcription — comma-separated list of ggml models to
# bake into the whisper-local image at build time. Tenants pick
# which ONE they want (from this list) on their Voicemail admin
# tab, plus an optional language for the multilingual models.
# Default covers fast/accurate English + two multilingual options.
# Add `medium` (+1.5GB) or `large-v3` (+3GB) for higher accuracy.
WHISPER_MODELS=tiny.en,base.en,small,large-v3-turbo

# TLS Certificate Management (acme.sh + Let's Encrypt)
# Set ACME_ENABLED=true after configuring your domain + DNS provider.
# acme.sh issues a wildcard cert (*.domain + domain) via DNS-01.
# See: https://github.com/acmesh-official/acme.sh/wiki/dnsapi
ACME_ENABLED=false
ACME_DOMAIN=
ACME_DNS_PROVIDER=dns_cf
ACME_WEBHOOK_TOKEN=
TLS_CERT_PATH=/etc/tls/fullchain.pem
TLS_KEY_PATH=/etc/tls/privkey.pem
# DNS provider credentials (Cloudflare example — adjust for your provider)
# ACME_DNS_CF_TOKEN=
# ACME_DNS_CF_ZONE_ID=

# Telephony - Kamailio SIP Proxy
# Set KAMAILIO_ENABLED=true after `sail up -d kamailio` so the
# admin panel shows the SIP Proxy page and the health probe
# treats the container as required rather than optional.
KAMAILIO_ENABLED=false
KAMAILIO_JSONRPC_URL=http://kamailio:8090/jsonrpc
# Comma-separated list, one URL per Kamailio node in the VRRP
# pair. State-changing RPCs (drain/activate) fan out to all of
# them so a drain survives VRRP failover — without this, the
# backup Kamailio would come up with stale dispatcher state and
# happily route new calls to a "drained" Asterisk.
KAMAILIO_JSONRPC_URLS=http://kamailio:8090/jsonrpc,http://kamailio-2:8090/jsonrpc

# Telephony - Asterisk
# AMI host/port here is only a single-backend FALLBACK for fresh
# installs. In HA, each Asterisk node lives as an AsteriskBackend
# row (Telephony → Asterisk Backends) with its own host + port;
# the service pulls those at runtime. AMI_USERNAME/SECRET are the
# cluster-wide AMI credentials — the same login applies to every
# backend, and both values are editable from System → Settings.
# ARI_URL/USERNAME/PASSWORD are likewise per-backend concerns
# and are not currently consumed anywhere in the Laravel app.
# If we start needing ARI (for in-flight call manipulation), the
# values would migrate onto the AsteriskBackend model, not here.
ASTERISK_AMI_HOST=asterisk-1
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=orbital
ASTERISK_AMI_SECRET=
ASTERISK_ARI_URL=http://asterisk-1:8088
ASTERISK_ARI_USERNAME=orbital
ASTERISK_ARI_PASSWORD=
# SIP domain is what the pjsip endpoint URIs use as the host part.
# For dev, localhost matches what the browser sees. In production
# this should be the public hostname the MX record points at.
ASTERISK_SIP_DOMAIN=localhost
# Browser-facing WSS endpoint. `asterisk/ws` because http.conf sets
# prefix=asterisk, so all HTTP paths are namespaced. The cert is
# self-signed in dev — browsers will refuse unless you accept it
# once at https://localhost:8089/asterisk/httpstatus.
ASTERISK_WSS_URL=wss://localhost:8089/asterisk/ws

# Operator dials a tenant's external DID (e.g. 15550000001) from
# the softphone and the call bounces into from-trunk as if it had
# come from a real SIP trunk. Handy for testing routing rules,
# voicemail mailboxes, and AI agents without a real phone.
# OFF by default — enable only in dev/staging. Never in production.
TELEPHONY_INTERNAL_DID_SIMULATION=false

# Telephony - LiveKit
LIVEKIT_URL=http://livekit:7880
LIVEKIT_WS_URL=ws://livekit:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_CLOUD_URL=
LIVEKIT_CLOUD_API_KEY=
LIVEKIT_CLOUD_API_SECRET=
LIVEKIT_MODE=local

# AI Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=

# Agent Worker
AGENT_WORKER_URL=http://agent-worker:8089
AGENT_WORKER_TOKEN=

# Icecast2 (self-hosted hold-music streaming server). Four
# passwords, each scoped to a different Icecast role:
#
#   ICECAST_SOURCE_PASSWORD  — what Asterisk uses to PUBLISH hold
#                              music streams to Icecast. Must match
#                              the value the asterisk service reads
#                              from its own env.
#   ICECAST_ADMIN_PASSWORD   — admin endpoint auth. Laravel reads
#                              this to reverse-proxy the admin UI at
#                              /icecast. ALSO editable in the admin
#                              UI under System → Settings → Icecast;
#                              values MUST stay in sync across both.
#   ICECAST_PASSWORD         — the "main" listener password, used
#                              internally by Icecast for privileged
#                              source/relay operations. Rarely needs
#                              to be different from ICECAST_SOURCE.
#   ICECAST_RELAY_PASSWORD   — only relevant once a second Icecast
#                              is configured as a master-to-relay
#                              slave (HA pattern). No effect on
#                              single-node deployments.
#
# Source / main / relay passwords are consumed INSIDE the icecast
# container (and Asterisk's MOH publisher) — changing them here
# requires a container restart. Only ICECAST_ADMIN_PASSWORD crosses
# into the Laravel side.
ICECAST_SOURCE_PASSWORD=changeme
ICECAST_ADMIN_PASSWORD=changeme
ICECAST_PASSWORD=changeme
ICECAST_RELAY_PASSWORD=changeme

# Sail
APP_SERVICE=orbital.test
WWWGROUP=1000
WWWUSER=1000
APP_PORT=80
VITE_PORT=5173
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

VITE_APP_NAME="${APP_NAME}"

# Reverb (self-hosted websocket broadcasting)
# App credentials are generated per-install by `php artisan reverb:install`
# and written directly into .env. Keep them out of .env.example so fresh
# clones are forced to generate their own instead of sharing keys.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Server-to-server hostname used by Laravel when it POSTs events to
# Reverb from inside the app container. In docker this is the
# compose service name (`reverb`). In production this is whatever
# internal hostname the app server uses to reach Reverb.
REVERB_HOST="reverb"
REVERB_PORT=8080
REVERB_SCHEME=http
# The Reverb daemon itself always binds to 0.0.0.0 inside the container so
# it's reachable from the Sail network AND the host port mapping.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Vite picks these up at build time so Echo can open the socket from
# the browser. VITE_REVERB_HOST is the BROWSER-VISIBLE hostname — on
# dev that's `localhost` (host port → reverb container port 8080);
# in production it's whatever public host fronts the websocket
# (e.g. `reverb.orbital.test`). Keep it separate from REVERB_HOST
# above, which is the server-side container hostname.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FORWARD_REVERB_PORT=8080
# Horizontal-scaling mode: when true, Reverb publishes every
# broadcast event onto Valkey pub/sub so every Reverb node
# receives and fans out the event to its connected clients.
# Required when running 2+ Reverb instances behind a load
# balancer (the default HA topology). Safe to leave on in
# single-node setups — the extra pub/sub roundtrip is cheap.
REVERB_SCALING_ENABLED=true
REVERB_SCALING_CHANNEL=reverb

# pgAdmin 4 — Postgres admin UI shipped alongside the app for
# local dev. Runs in "desktop mode" (single admin account, no
# master password) so you can click through the nav entry and
# hit the database. Change the default email/password before
# exposing pgAdmin to anywhere other than localhost.
# pgAdmin — in SSO mode, authentication comes from Laravel's OIDC
# provider (see PGADMIN_OAUTH2_* below). DEFAULT_EMAIL/PASSWORD are
# no longer used once server mode is flipped on; kept blank so a
# partial rollback doesn't accidentally re-enable desktop login.
FORWARD_PGADMIN_PORT=5050

# Unified SSO — the SsoSecretsBootstrapper populates all of the
# keys below on first run and rotates them on subsequent runs.
# Leave empty in .env.example; the bootstrapper fills them in.
REDIS_COMMANDER_SSO_SECRET=
REDIS_COMMANDER_SSO_ISSUER=orbital-admin
GRAFANA_PROXY_TRUST_TOKEN=
GRAFANA_INTERNAL_URL=http://grafana:3000
PGADMIN_OAUTH2_CLIENT_ID=
PGADMIN_OAUTH2_CLIENT_SECRET=

# Redis Commander — lightweight Valkey/Redis web browser. HTTP
# basic auth is enabled via the two vars below. Redis Commander
# also uses REDIS_PASSWORD (above) to talk to Valkey, so rotating
# that value doesn't require any Commander-specific change.
FORWARD_REDIS_COMMANDER_PORT=8082
REDIS_COMMANDER_HTTP_USER=admin
REDIS_COMMANDER_HTTP_PASSWORD=
