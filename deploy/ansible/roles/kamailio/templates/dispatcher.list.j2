# Kamailio dispatcher list — populated from `kamailio_dispatcher_targets`.
#
# Format:  set_id(int) destination(URI) flags
# Flags:   0 = no flags; 1 = inactive; 2 = trying; 4 = inactive auto-resume
#
# Re-rendered by Ansible on every playbook run. To change the active
# pool live without a playbook re-run, the FailoverCentral / SipProxy
# admin UIs call `dispatcher.set_state` over JSON-RPC; that change is
# in-memory only and survives until the next reload.
#
# {{ ansible_managed }}

{% for target in kamailio_dispatcher_targets %}
{{ kamailio_dispatcher_set_id }} sip:{{ target.host }}:{{ target.port | default(5060) }} 0
{% endfor %}
