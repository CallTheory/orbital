; rtpengine recording-daemon — converts pcap captures to per-leg WAVs.
;
; Output pattern matches what Laravel's
; `App\Console\Commands\UploadRtpengineRecordings::parseFilename()`
; expects: `<call-id>-recv.wav` / `<call-id>-send.wav` per dialog.
;
; {{ ansible_managed }}

[rtpengine-recording]
spool-dir = {{ rtpengine_recording_dir }}
output-dir = {{ rtpengine_recording_dir }}/finalized
output-mixed = no
output-single = yes
output-format = wav
metadata-pattern = call-id-%c--leg-%l.wav
log-stderr = true
log-level = {{ rtpengine_log_level }}
