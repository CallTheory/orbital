# On-prem K3s — example tfvars.

# --- VM IPs (you provision these out-of-band) ---
edge_vm_ips    = ["10.0.0.10", "10.0.0.11"]
k3s_server_ips = ["10.0.0.20"]
k3s_agent_ips  = ["10.0.0.30", "10.0.0.31"]

# --- SSH access ---
ssh_user             = "ubuntu"
ssh_private_key_path = "~/.ssh/orbital-deploy"
admin_authorized_keys = [
  "ssh-ed25519 AAAAC3Nz... operator@laptop",
]

# --- TLS ---
tls_email  = "ops@yourdomain.com"
tls_domain = "sip.orbital.yourdomain.com"

tls_webhook_url   = "https://orbital.yourdomain.com/api/tls/renewed"
tls_webhook_token = "GENERATE_WITH_openssl_rand_hex_32"

# --- Repo source for the Ansible playbooks ---
ansible_repo_url = "https://github.com/calltheory/orbital.git"
ansible_branch   = "main"
