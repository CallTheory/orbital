# Vultr managed VKE — example tfvars.

vultr_api_key = "VULTR_API_KEY"
region        = "ewr"

ssh_public_key = "ssh-ed25519 AAAAC3Nz... operator@laptop"
admin_authorized_keys = []

cluster_name = "orbital-prod"

# vke_version         = "v1.31.0+1"
# vke_node_pool_size  = "vc2-4c-8gb"
# vke_node_pool_count = 3

# edge_instance_size  = "vc2-2c-4gb"
# edge_instance_count = 2

tls_email  = "ops@yourdomain.com"
tls_domain = "sip.orbital.yourdomain.com"

tls_webhook_url   = "https://orbital.yourdomain.com/api/tls/renewed"
tls_webhook_token = "GENERATE_WITH_openssl_rand_hex_32"

ansible_repo_url = "https://github.com/calltheory/orbital.git"
ansible_branch   = "main"
