# Vultr self-hosted K3s — example tfvars.
#
# Copy to `terraform.tfvars` (which is .gitignored) and fill in.
# Run `tofu apply -var-file=terraform.tfvars` from this directory.

# --- Vultr API credentials ---
vultr_api_key = "VULTR_API_KEY_FROM_https://my.vultr.com/settings/#settingsapi"

# --- Region ---
# `vultr regions list` for the full menu. Common picks:
#   ewr  Newark (US East)
#   sjc  Silicon Valley (US West)
#   ams  Amsterdam (EU)
#   syd  Sydney
region = "ewr"

# --- Operator SSH key ---
# Pasted public key (single string, no newline). The OpenTofu
# module also generates its own deploy key — this is your
# personal access key on top.
ssh_public_key = "ssh-ed25519 AAAAC3Nz... operator@laptop"

admin_authorized_keys = [
  # Add team members' SSH keys here for shared edge access.
]

# --- Cluster identity ---
cluster_name = "orbital-prod"

# --- Sizing (overrides — defaults work for small / dev installs) ---
# edge_instance_size  = "vc2-2c-4gb"     # 2 vCPU / 4 GB — handles ~50 concurrent calls
# edge_instance_count = 2                # 2 = active/active
# k3s_server_size     = "vc2-4c-8gb"
# k3s_server_count    = 1                # 1 dev / 3 HA
# k3s_agent_size      = "vc2-4c-8gb"
# k3s_agent_count     = 2

# --- TLS ---
tls_email  = "ops@yourdomain.com"
tls_domain = "sip.orbital.yourdomain.com"

tls_webhook_url   = "https://orbital.yourdomain.com/api/tls/renewed"
tls_webhook_token = "GENERATE_WITH_openssl_rand_hex_32"

# --- Repo source for cloud-init's ansible-pull ---
ansible_repo_url = "https://github.com/calltheory/orbital.git"
ansible_branch   = "main"
